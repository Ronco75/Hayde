# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hayde"

# JWT configuration
JWT_SECRET="your-secret-key-here"  # MUST be changed in production!
JWT_EXPIRES_IN="7d"                # Token expiration (7 days default)

# Email service (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Hayde <onboarding@resend.dev>"

# Frontend URL (for password reset links)
FRONTEND_URL="http://localhost:5173"

# ===========================================
# Twilio WhatsApp Configuration
# ===========================================
#
# Twilio is used for sending WhatsApp invitations and reminders.
# If these variables are not set, WhatsApp functionality will run
# in development mode (messages logged to console instead of sent).
#
# Setup Instructions:
# 1. Create a Twilio account at https://www.twilio.com
# 2. Get your Account SID and Auth Token from the Console Dashboard
# 3. For testing: Use the WhatsApp Sandbox
#    - Go to Messaging > Try it out > Send a WhatsApp message
#    - Follow the sandbox setup instructions
#    - The sandbox number is: whatsapp:+14155238886
# 4. For production: Apply for WhatsApp Business API access
#
# IMPORTANT: To test the WhatsApp Sandbox:
# - Send "join <your-sandbox-code>" to +1 415 523 8886 from WhatsApp
# - This links your phone to the sandbox for 72 hours
#
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"  # Sandbox number (or your approved WhatsApp number)
